# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas cluster connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/mealbridge

# JWT Authentication Secret
JWT_SECRET=mealbridge_super_secret_jwt_key_2026

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration (if using cloud image storage for food photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Google Gemini API Key for MealBot & AI Risk Predictor
GEMINI_API_KEY=
